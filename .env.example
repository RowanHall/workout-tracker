# Supabase client credentials. These are the *publishable* (public) keys for
# the project — safe to ship in the app bundle, but kept out of git by
# convention. Copy this file to .env to run the app:
#
#   cp .env.example .env
#
EXPO_PUBLIC_SUPABASE_URL=https://fhjputpyqxujwstafsss.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_NNvplvke4Ak-F4BN_IFWPw_x2JKT8l5

# RevenueCat public SDK keys (safe to embed — they're designed to ship in the
# app). Get them from RevenueCat → Project settings → API keys. Leave blank to
# disable in-app purchases; the Premium tab then degrades gracefully.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
